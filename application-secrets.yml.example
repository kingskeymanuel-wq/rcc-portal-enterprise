# Copiez ce fichier en "application-secrets.yml" (SANS le .example) à la RACINE du projet
# (là où se trouve pom.xml — pas dans src/main/resources), remplissez votre vraie clé, et
# c'est tout : plus besoin de setx ni de redémarrer IntelliJ, Spring Boot lit ce fichier
# directement à chaque démarrage.
#
# Ce fichier ("application-secrets.yml", sans .example) est dans .gitignore — il ne sera
# jamais commité, votre clé reste privée.

spring:
  datasource:
    username: "votre-utilisateur-sql"
    password: "votre-mot-de-passe-sql"

rcc:
  auth:
    gateway:
      hmac-secret: "secret-hmac-fourni-par-l-IT"
      aes-password: "mot-de-passe-aes-fourni-par-l-IT"
    test-bypass:
      enabled: true   # comptes de test — uniquement sur votre poste

quality:
  ai:
    anthropic-key: "sk-ant-api03-VOTRE-VRAIE-CLE-ICI"

# Intégration réelle Teams/Outlook — voir docs/GRAPH_SETUP.md pour la procédure complète.
graph:
  tenant-id: "votre-tenant-id-azure"
  client-id: "votre-client-id-azure"
  client-secret: "votre-client-secret-azure"
